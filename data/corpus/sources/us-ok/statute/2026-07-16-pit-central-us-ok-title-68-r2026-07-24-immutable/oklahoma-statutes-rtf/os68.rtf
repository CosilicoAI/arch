\par }\pard \ltrpar\ql \fi576\li0\ri0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid10035627 {\rtlch\fcs1 \af2 \ltrch\fcs0 \cf1\insrsid11747436\charrsid7358214 
