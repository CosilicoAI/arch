\par }\pard\plain \ltrpar\ql \fi576\li0\ri0\widctlpar\tx576\tx1296\tx2016\tx2736\tx3456\tx4176\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid14442205 \rtlch\fcs1 \af0\afs20\alang1025 \ltrch\fcs0 
