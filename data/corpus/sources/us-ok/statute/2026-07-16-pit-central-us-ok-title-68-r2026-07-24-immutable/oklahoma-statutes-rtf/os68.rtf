\par }\pard \ltrpar\ql \fi576\li0\ri0\widctlpar\tx576\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid12335128 {\rtlch\fcs1 \af2 \ltrch\fcs0 \insrsid11747436\charrsid12335128 
