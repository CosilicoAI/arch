\par }\pard \ltrpar\ql \fi-720\li2016\ri0\widctlpar\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin2016\itap0\pararsid228809 {\rtlch\fcs1 \af2 \ltrch\fcs0 \insrsid11747436\charrsid228809 a.\tab a person,
