\par }\pard \ltrpar\ql \fi576\li0\ri0\widctlpar\tx720\tx2700\tx3600\wrapdefault\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid8025767 {\rtlch\fcs1 \af2\afs24 \ltrch\fcs0 \insrsid11747436\charrsid1189766 B.  Ex
