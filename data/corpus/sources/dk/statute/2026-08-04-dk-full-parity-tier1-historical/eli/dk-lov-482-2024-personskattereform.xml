                <Exitus>
                  <Linea>
                    <Char>Bundfradraget udgør 566.500 kr. (2010-niveau).</Char>
                  </Linea>
                  <Linea>
                    <Char>Bundfradraget reguleres efter § 20.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
