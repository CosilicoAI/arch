              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 9, 3. </Char>
                <Char>og </Char>
                <Char signiChar="AendringURN" formaChar="Italic">4. pkt.,</Char>
                <Char> ophæves, og i stedet indsættes:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idcc15d391-56a0-419d-ba7e-9a47ea436924">
            <AendringNyTekst>
              <Stk id="id4730b8ec-4523-433e-92c1-d5d289cc7eef">
                <Exitus>
                  <Linea>
                    <Char>I det omfang skatteværdien af personfradraget beregnet med skatteprocenten efter § 6 ikke kan fradrages i skatten efter § 6, fragår den i nævnte rækkefølge i skatterne efter §§‍‍ 7, 7 a og 8 og § 8 a, stk. 2.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
