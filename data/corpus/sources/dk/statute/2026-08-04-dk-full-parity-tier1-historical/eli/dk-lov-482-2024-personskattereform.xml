                  <Exitus>
                    <Linea>
                      <Char>Skatten efter § 5, nr. 3, udgør 7,5 pct. af den personlige indkomst, i det omfang den personlige indkomst overstiger bundfradraget i stk. 2.</Char>
                    </Linea>
                  </Exitus>
                </Stk>
