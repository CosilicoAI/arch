  <TitelGruppe id="id4cce4fe3-8f79-4f77-a0f2-aac9e366ca13">
    <Titel id="id8e340a83-a9d5-4a73-ad07-9013b3eeee6e">
      <Linea>
        <Char>Lov om ændring af SU-loven</Char>
      </Linea>
    </Titel>
    <UnderTitel id="id5645f8bb-c558-4bb6-99b2-a9ed12f6e46e">
      <Linea>
        <Char>(Reform af SU-systemet på det videregående uddannelsesområde)</Char>
      </Linea>
    </UnderTitel>
  </TitelGruppe>
  <DokumentIndhold id="id84b5658e-7f08-4017-b439-bf158f795d6e">
    <Hymne id="idcda25592-8f67-427d-bd5a-8381a5ecaa66">
      <Exitus>
        <Linea>
          <Char>VI FREDERIK DEN TIENDE, af Guds Nåde Danmarks Konge, gør vitterligt:</Char>
        </Linea>
      </Exitus>
      <Exitus>
        <Linea>
          <Char>Folketinget har vedtaget og Vi ved Vort samtykke stadfæstet følgende lov:</Char>
        </Linea>
      </Exitus>
    </Hymne>
    <AendringCentreretParagraf id="id8a178cce-92a2-4982-86b5-4f1d5ca539ea" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I SU-loven, jf. lovbekendtgørelse nr. 395 af 13. april 2023, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="idae9e756c-0e8a-435b-859f-dffb32a6c8c8">
        <Explicatus>1.</Explicatus>
        <Aendring id="ida8f9f04e-99c5-4638-841f-250371717563">
          <AendringDefinition id="idf174a5d3-2d29-4529-8f8d-a79681fabcc2">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 16, stk. 1,</Char>
                <Char> ændres »70« til: »58«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idc376ec37-3c03-4284-99c4-0330087a8973">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id9f31244e-5828-4a6a-b670-33ec03aa590e">
        <Explicatus>2.</Explicatus>
        <Aendring id="id10576407-1450-4b10-8c79-d64eef841286">
          <AendringDefinition id="idf2d1b502-5210-4d2a-b112-6c5e78303bc6">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 16</Char>
                <Char> indsættes efter stk. 1 som nyt stykke:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idcbfa55c4-cdef-47ad-b19b-5efbab7afb19">
            <AendringNyTekst>
              <Stk id="idcaa69dd4-5946-44b3-9e7b-9e30b07af3af">
                <Explicatus>Stk. 2.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Rammen udvides med 12 klip for uddannelsessøgende, der modtager stipendium som tillæg efter § 7, stk. 3 eller stk. 4, nr. 1.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
        <Rykningsklausul id="idac08ffa7-9aa3-4dcb-8c05-c98c1f46ed5c">
          <Exitus>
            <Linea>
              <Char>Stk. 2-6 bliver herefter stk. 3-7.</Char>
            </Linea>
          </Exitus>
        </Rykningsklausul>
      </AendringsNummer>
      <AendringsNummer id="id073e9512-b31d-40c5-8ed7-1b949e4b4af4">
        <Explicatus>3.</Explicatus>
        <Aendring id="id8fda24b1-404f-4f96-8581-29fd57b61052">
          <AendringDefinition id="idf3efa604-b8ba-477b-9eb4-009f1ecd6f90">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char formaChar="Italic">§ 16, stk. 5,</Char>
                <Char> der bliver stk. 6, ændres »stk. 2-4« til: »stk. 3-5«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id0770015a-7b7d-4c99-bfa6-15923ed54434">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id329d50a7-45ec-4471-b447-ab6e429827ea">
        <Explicatus>4.</Explicatus>
        <Aendring id="id6990ef15-0a10-4cd4-98f6-f56eb37625e2">
          <AendringDefinition id="id2044b307-5e47-4c1d-8c7d-19e23a8b7196">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char formaChar="Italic">§ 16, stk. 6,</Char>
                <Char> der bliver stk. 7, ændres »stk. 3 og 4 og« til: »stk. 2, 4 og 5 og kan«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id3aaf8280-7736-42b0-86a6-da4b83f51412">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="idba174757-638d-4398-9db5-9d06e9a5dada">
        <Explicatus>5.</Explicatus>
        <Aendring id="id2f261d93-ad41-4d79-ab06-bba2e9c38aff">
          <AendringDefinition id="id7051ebe9-bf97-4fb0-a7e9-8e4a9e5b66dc">
            <Exitus>
              <Linea>
                <Char formaChar="Italic">§ 17, stk. 2-4, </Char>
                <Char>ophæves, og i stedet indsættes:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idd28790d3-565d-4d15-a2b9-5e422965f534">
            <AendringNyTekst>
              <Stk id="id14c7d514-ee6d-4b96-a273-b60f99494ba1">
                <Explicatus>Stk. 2.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Uddannelsessøgende, der modtager stipendium som tillæg efter § 7, stk. 3 eller stk. 4, nr. 1, gives en støttetid, der svarer til den normerede uddannelsestid med et tillæg på 12 klip.</Char>
                  </Linea>
                </Exitus>
              </Stk>
              <Stk id="idb4407e7d-c658-4df6-a3d4-0f1b3b215182">
                <Explicatus>Stk. 3.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Uddannelses- og forskningsministeren kan fastsætte nærmere regler om støttetiden efter stk. 2.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="ide8eccd8a-ef88-4d2b-bb61-b81e911bd2f1">
        <Explicatus>6.</Explicatus>
        <Aendring id="idfdd30159-ff85-4d03-9101-f720d1e154be">
          <AendringDefinition id="id6bd7a2eb-6ac7-466e-a430-b1f23749b243">
            <Exitus>
              <Linea>
                <Char formaChar="Italic">§ 21, stk. 1, 2. pkt.,</Char>
                <Char> ophæves.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id49c6b908-5d15-46db-976c-cc705a400a78">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id470962ae-0b65-48ad-b857-5acdf6b7d028">
        <Explicatus>7.</Explicatus>
        <Aendring id="ida73d21b8-a71c-4b2e-a41c-3821a4859876">
          <AendringDefinition id="id009c621b-414b-4325-ae8c-c86276337e2d">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char formaChar="Italic">§ 21, stk. 2,</Char>
                <Char></Char>
                <Char formaChar="Italic">2. pkt.,</Char>
                <Char> udgår »eller inden for 12 måneder for uddannelsessøgende med udvidet støttetid efter § 17, stk. 2«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id8cf0ae45-8472-4a9a-8350-01643f284e24">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
    </AendringCentreretParagraf>
    <IkraftCentreretParagraf id="idcd006191-684c-4712-9f77-44cb24a791fe" localId="2">
      <Explicatus>§ 2</Explicatus>
      <Stk id="idfe421fe7-fd03-43cb-9a66-d95fb95f12c9">
        <Explicatus>Stk. 1.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven træder i kraft den 1. december 2026.</Char>
          </Linea>
        </Exitus>
      </Stk>
      <Stk id="id783762af-925a-4a87-ab25-dd70c99aa48e">
        <Explicatus>Stk. 2.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven har virkning for uddannelsesstøtte, der udbetales for januar 2027 eller senere, jf. dog stk. 3.</Char>
          </Linea>
        </Exitus>
      </Stk>
      <Stk id="id23ca6f9b-db80-4ae3-9d25-b8d62987232a">
        <Explicatus>Stk. 3.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven har alene virkning for uddannelsesstøtte til uddannelsessøgende,</Char>
          </Linea>
        </Exitus>
        <Exitus id="id5190062e-4f8b-47bc-8880-f8998b8f5d93">
          <Index>
            <Indentatio id="ida7b831fe-b02e-409d-aadc-88e706b39473" formaInd="Nummer">
              <Explicatus>1)</Explicatus>
              <Exitus>
                <Linea>
                  <Char>som påbegynder en ny uddannelse, der kan gives uddannelsesstøtte til inden for klippekortet, den 1. juli 2025 eller senere, eller</Char>
                </Linea>
              </Exitus>
            </Indentatio>
            <Indentatio id="id1cf190d2-344e-4b38-a002-8889b3b311d9" formaInd="Nummer">
              <Explicatus>2)</Explicatus>
              <Exitus>
                <Linea>
                  <Char>som den 1. juli 2030 eller senere genoptager en tidligere påbegyndt uddannelse, der kan gives uddannelsesstøtte til inden for klippekortet, og som er påbegyndt før den 1. juli 2025.</Char>
                </Linea>
              </Exitus>
            </Indentatio>
          </Index>
        </Exitus>
      </Stk>
      <Stk id="id9e7a4ea7-ee42-4de9-a6e2-cc7f7ac69d83">
        <Explicatus>Stk. 4.</Explicatus>
        <Exitus>
          <Linea>
            <Char>For uddannelsesstøtte, som ikke er omfattet af stk. 2 og 3, finder de hidtil gældende regler anvendelse.</Char>
          </Linea>
        </Exitus>
      </Stk>
      <Stk id="id3c69d40a-dc0d-4d35-895a-05bfbe2a34cf">
        <Explicatus>Stk. 5.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Regler udstedt i medfør af § 16, stk. 6, i SU-loven, jf. lovbekendtgørelse nr. 395 af 13. april 2023, forbliver i kraft, indtil de ophæves eller afløses af regler udstedt i medfør af § 16, stk. 7, i SU-loven, jf. denne lovs § 1, nr. 2.</Char>
          </Linea>
        </Exitus>
      </Stk>
      <Stk id="ided7df051-bdc0-4e5e-82d1-71ce8dda5eac">
        <Explicatus>Stk. 6.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Regler udstedt i medfør af § 17, stk. 3 og 4, i SU-loven, jf. lovbekendtgørelse nr. 395 af 13. april 2023, forbliver i kraft, indtil de ophæves.</Char>
          </Linea>
        </Exitus>
      </Stk>
    </IkraftCentreretParagraf>
  </DokumentIndhold>
