      </AendringsNummer>
      <AendringsNummer id="id99d8707f-95ff-4c71-9430-c43b02042413">
        <Explicatus>10.</Explicatus>
        <Aendring id="idab31e913-8cee-4aea-bbfd-6e418b0da2da">
          <AendringDefinition id="ida79361cf-6305-4cf8-9c78-fc6a93248236">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 4, stk. 9,</Char>
                <Char> indsættes som </Char>
                <Char signiChar="AendringURN" formaChar="Italic">2. pkt.:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id092a3cb2-a4be-4ae4-a704-48106a166c02">
            <AendringNyTekst>
              <Exitus>
                <Linea>
                  <Char>Udbetaling af børneydelse efter stk. 1-7 skal ved indrejse i Danmark eller hjemgivelse ske med virkning fra næstkommende kvartal, og udbetaling af ungeydelse efter stk. 1-7 skal ved indrejse i Danmark eller hjemgivelse ske med virkning fra næstkommende måned, i hvilken retten til ydelsen er erhvervet.</Char>
                </Linea>
              </Exitus>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
