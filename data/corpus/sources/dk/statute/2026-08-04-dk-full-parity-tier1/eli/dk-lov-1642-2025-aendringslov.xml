                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 4, stk. 6,</Char>
                <Char> indsættes efter »udbetales«: »helt eller delvis«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
