                            <Exitus>
                              <Linea>
                                <Char>Erklæring om, at barnet opholder sig mindst 9 ud af 14 dage hos den ene forældremyndighedsindehaver.</Char>
                              </Linea>
                            </Exitus>
                          </Indentatio>
                          <Indentatio id="idf4dc4fca-ffef-452c-bd3b-46d11fb06a5f" formaInd="Nummer">
                            <Explicatus>2)</Explicatus>
                            <Exitus>
