          <AendringDefinition id="idc14ceb5d-49d6-4b9f-96da-ee99cc179252">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 33, stk. 1, nr. 4,</Char>
                <Char> indsættes efter »ligningslovens § 7, nr. 22 og 40«: », samt indtægter fra salg af sociale aviser, jf. ligningslovens § 7, nr. 42«.</Char>
