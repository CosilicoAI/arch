    <AendringCentreretParagraf id="id645f1040-fdee-4ec2-8106-80c507b888fe" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I lov om social pension, jf. lovbekendtgørelse nr. 527 af 25. april 2022, som ændret bl.a. ved § 1 i lov nr. 875 af 21. juni 2022 og § 1 i lov nr. 726 af 13. juni 2023 og senest ved § 2 i lov nr. 1769 af 28. december 2023, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="id36ecaf42-ca11-4a6c-978f-80f6954c1679">
        <Explicatus>1.</Explicatus>
        <Aendring id="id2699c05e-b1e1-41d3-b36a-a103f3fc0582">
          <AendringDefinition id="id487c7a39-8c16-459d-85b4-6feeaed24704">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 29, stk. 1, nr. 1, </Char>
                <Char>indsættes efter »Personlig indkomst,«:</Char>
                <Char formaChar="Bold"></Char>
                <Char>»som består af indtægt ved personligt arbejde og anden personlig indkomst,«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id4c15271a-8647-42aa-8ba5-2bba1b1d46b8">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id6eea3f56-f07c-4007-9d2a-9fded25ea2c5">
        <Explicatus>2.</Explicatus>
        <Aendring id="id1e5879a7-eee5-4658-a25c-8c3fb10210e7">
          <AendringDefinition id="ida710fce3-cc48-4346-b702-a2892796eb64">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 32 a, stk. 1, nr. 1, </Char>
                <Char>indsættes efter </Char>
                <Char formaChar="Bold">»</Char>
                <Char>Personlig indkomst,«:</Char>
                <Char formaChar="Bold"></Char>
                <Char>»som består af indtægt ved personligt arbejde og anden personlig indkomst,«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idd803fdff-0318-4288-b8ec-4aed9426c45d">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id127e9b0e-f623-4488-999c-602fa3386cc3">
        <Explicatus>3.</Explicatus>
        <Aendring id="idcad4fd63-311e-4ce4-869c-5d913bae7264">
          <AendringDefinition id="iddc8633e1-8972-455f-85ed-41d34ed99a58">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 39 b, stk. 2, 1. pkt.,</Char>
                <Char> ændres »indtægten« til: »indtægtsgrundlaget«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
