          <AendringDefinition id="id36e08b0c-a6f6-47be-96c8-b47d0950d249">
            <Exitus>
              <Linea>
                <Char>Efter § 6 indsættes:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idfef03c51-8917-4b34-852a-4e4935f1f499">
            <AendringNyTekst>
              <Paragraf id="id94d71006-e7ab-414d-88ec-e6cfab966526" localId="7">
                <Explicatus>§ 7.</Explicatus>
                <Stk id="id9cd4fc3f-f944-4ebf-be15-ec380b1b1e4e">
                  <Exitus>
                    <Linea>
                      <Char>Vejledning om valg af ungdomsuddannelse og erhverv skal ske i et samarbejde med uddannelsesinstitutionerne og med inddragelse af organisationer og virksomheder på arbejdsmarkedet.</Char>
                    </Linea>
                  </Exitus>
                </Stk>
              </Paragraf>
            </AendringNyTekst>
          </AendringAktion>
