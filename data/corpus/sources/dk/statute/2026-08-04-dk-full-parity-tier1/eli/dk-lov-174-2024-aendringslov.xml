              <Stk id="iddab65acd-7b92-443d-9697-f0d7c07f5f75">
                <Explicatus>Stk. 4.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Følgende skal fremgå af planen, jf. stk. 1, for så vidt angår 10. klasse:</Char>
