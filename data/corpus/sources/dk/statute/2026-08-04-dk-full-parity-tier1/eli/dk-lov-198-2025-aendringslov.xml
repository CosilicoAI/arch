      <Exitus>
        <Linea>
          <Char>VI FREDERIK DEN TIENDE, af Guds Nåde Danmarks Konge, gør vitterligt:</Char>
        </Linea>
      </Exitus>
      <Exitus>
        <Linea>
          <Char>Folketinget har vedtaget og Vi ved Vort samtykke stadfæstet følgende lov:</Char>
        </Linea>
      </Exitus>
    </Hymne>
    <AendringCentreretParagraf id="iddbaa0c90-e5cf-4006-9a09-978f79d75307" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I lov om aktiv socialpolitik, jf. lovbekendtgørelse nr. 808 af 25. juni 2024, som ændret bl.a. ved § 2 i lov nr. 1654 af 30. december 2024, § 1 i lov nr. 1655 af 30. december 2024 og § 11 i lov nr. 1687 af 30. december 2024 og senest ved § 14 i lov nr. 1703 af 30. decembe 2024, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="idc94abffc-557e-40c2-a6a0-3feb59e23049">
        <Explicatus>1.</Explicatus>
        <Aendring id="id5d8ed681-8013-4ba7-941f-d2f4df760273">
          <AendringDefinition id="id10308ef9-7612-4b77-a776-20373eb7b40a">
            <Exitus>
              <Linea>
                <Char formaChar="Italic">§ 5, stk. 3,</Char>
                <Char> affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idad8bab55-ffa4-416f-b636-3bcafe84c2f4">
            <AendringNyTekst>
              <Stk id="id32b4a830-49b0-41fb-a49d-a5e117296e72">
                <Explicatus>Stk. 3.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Personer kan opholde sig kortvarigt i udlandet.</Char>
                  </Linea>
                  <Linea>
                    <Char>Personer kan derudover overnatte i udlandet højst én gang pr. kalendermåned samtidig med modtagelse af hjælp efter denne lov, jf. dog stk. 5.</Char>
                  </Linea>
                  <Linea>
                    <Char>Overnatningen må ikke ske i forbindelse med påbegyndelse eller afslutning af en ferieperiode.</Char>
                  </Linea>
                  <Linea>
                    <Char>Personen skal senest 2 dage før udlandsophold efter 2. pkt. give kommunen besked herom.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id66b27516-fb00-46de-952c-bf9b018edf35">
        <Explicatus>2.</Explicatus>
        <Aendring id="id021c7616-34d5-4fef-bd85-6b58a0103631">
          <AendringDefinition id="id2f504729-49d2-4036-b3da-95374e957db7">
            <Exitus>
              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 13, stk. 9,</Char>
                <Char> affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idf3c0740c-e470-4b7e-b4e4-b4957ce52056">
            <AendringNyTekst>
              <Stk id="id3100b549-8b8f-4d36-953a-401ec27a9f99">
                <Explicatus>Stk. 9.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>En person er fritaget for at stå til rådighed i perioder, hvor personen har ret til fravær ved graviditet, barsel, adoption og sorgorlov efter barselslovens § 6, stk. 1 og 2, §§ 7, 7 a, 8, 8 a og 8 b, § 9, stk. 1, § 13, § 14, stk. 1 og 2, og § 14 a, i det omfang der under fraværet ville have været ret til dagpenge som ledig efter barselslovens § 20, § 21, stk. 1 og 2, § 21 b, stk. 1-3, § 21 c, stk. 1-3, § 21 d, § 23 b, stk. 1-3, og § 23 c, stk. 1 og 2.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id76ca2923-46fa-40aa-b132-7b960ebc7ebe">
        <Explicatus>3.</Explicatus>
        <Aendring id="ide378e2cb-8712-46fa-8668-97dec95c2135">
          <AendringDefinition id="idc303daf9-b58f-4de3-9078-4c9feb162859">
            <Exitus>
              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 13, stk. 14, 1. pkt., </Char>
                <Char>affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id1a95e1b8-4e21-4d40-a155-5936b135c9e0">
            <AendringNyTekst>
              <Stk id="id361da762-50f2-4c74-8445-878320e582ca">
                <Exitus>
                  <Linea>
                    <Char>Beskæftigelsesministeren fastsætter nærmere regler om anvendelsen af bestemmelserne i stk. 1-8, herunder regler om, hvornår kommunen skal kræve frigørelsesattest, hvis ansøgeren eller ægtefællen har deltidsarbejde.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="id1ead2142-3450-4bec-9a65-826af48eb864">
        <Explicatus>4.</Explicatus>
        <Aendring id="idaa59547a-9fb6-47a5-a793-5d7aedce938f">
          <AendringDefinition id="id3b0a2eff-8322-4a7a-b41d-3d3c80a9906f">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 14, stk. 1, 2. pkt., </Char>
                <Char>ændres »30.000 kr. (2024-niveau)« til: »det dobbelte beløb«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="ida0973576-fec7-4607-8062-01a48ee964a9">
            <AendringNyTekst />
          </AendringAktion>
