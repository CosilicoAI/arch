            <Exitus>
              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 20, stk. 7, 2. pkt., </Char>
                <Char>affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id51903203-31c1-41dd-b7fc-911b624fe8c1">
            <AendringNyTekst>
              <Stk id="id8b6df263-e16f-42c9-9e31-b3554c1373d1">
                <Exitus>
                  <Linea>
                    <Char>For personer omfattet af stk. 1, nr. 5, der er fyldt 25 år, og som modtager tillæg som enlig efter § 18, stk. 3, er det endvidere en betingelse, at disse ikke har ret til et særligt ungetillæg efter § 19 for juli 2025.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
