      <AendringsNummer id="id037cb19e-f6a4-4e7d-bbbc-3465dfdd3da0">
        <Explicatus>4.</Explicatus>
        <Aendring id="id7a4e67de-d2af-4118-898d-03050534d08c">
          <AendringDefinition id="idc4fc7adb-1452-4350-84cf-346beeec30dc">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 11, stk. 1, 3. pkt.,</Char>
                <Char> indsættes efter »afkastgrundlag«: »opgjort efter virksomhedsskattelovens § 8, stk. 1 og 2,«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idfcf50f8d-f32a-484b-87f7-5ce5ae2c5a20">
