              <Linea>
                <Char>I </Char>
                <Char signiChar="AendringURN" formaChar="Italic">§ 11, stk. 1, 2.</Char>
                <Char> og </Char>
                <Char signiChar="AendringURN" formaChar="Italic">3. pkt., </Char>
                <Char>ændres »henholdsvis« til: »eller«.</Char>
