          <AendringAktion id="idc4ccd398-5bb5-447d-b24c-c68e035c5cb8">
            <AendringNyTekst>
              <Paragraf id="idc08aff82-0ee1-42c0-b198-cc53e84cb4c0" localId="2d">
                <Explicatus>§ 2 d.</Explicatus>
                <Stk id="id543c89a3-df50-4362-9251-08b610b94319">
                  <Exitus>
                    <Linea>
                      <Char>Der svares afgift af folier fremstillet af blødt polyvinylklorid (pvc), der er egnet til emballering af levnedsmidler.</Char>
                    </Linea>
                  </Exitus>
                </Stk>
                <Stk id="id1f566d8d-24b3-4c48-9812-9d9aa9fe81b4">
                  <Explicatus>Stk. 2.</Explicatus>
                  <Exitus>
                    <Linea>
                      <Char>Afgiften udgør 43,71 kr. pr. kg.</Char>
                    </Linea>
                    <Linea>
                      <Char>Til og med den 31. december 2023 udgør afgiften dog 40,70 kr. pr. kg.</Char>
                    </Linea>
                  </Exitus>
                </Stk>
              </Paragraf>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
