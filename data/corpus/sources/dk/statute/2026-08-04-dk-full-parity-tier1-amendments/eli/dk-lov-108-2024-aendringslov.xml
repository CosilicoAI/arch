    <UnderTitel id="idad2cf744-5e2e-4f93-a46d-62a9e288fcdb">
      <Linea>
        <Char>(Nedsættelse af bundskatten som følge af kommunale skattestigninger)</Char>
      </Linea>
    </UnderTitel>
  </TitelGruppe>
  <DokumentIndhold id="id1b923fe5-5559-4b42-88bb-1483b39388f2">
    <Hymne id="id15336dfc-9af7-483f-9184-15096140deca">
      <Exitus>
        <Linea>
          <Char>VI FREDERIK DEN TIENDE, af Guds Nåde Danmarks Konge, gør vitterligt:</Char>
        </Linea>
      </Exitus>
      <Exitus>
        <Linea>
          <Char>Folketinget har vedtaget og Vi ved Vort samtykke stadfæstet følgende lov:</Char>
        </Linea>
      </Exitus>
    </Hymne>
    <AendringCentreretParagraf id="ide7ea5e27-49b5-46a4-baf4-913fe8b73a5a" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I personskatteloven, jf. lovbekendtgørelse nr. 1284 af 14. juni 2021, som ændret ved lov nr. 252 af 25. februar 2022, lov nr. 610 af 31. maj 2023, § 12 i lov nr. 679 af 3. juni 2023 og § 1 i lov nr. 1564 af 12. december 2023, foretages følgende ændring:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="id0da49b13-a8c5-443e-8842-b6a5a990586a">
        <Explicatus>1.</Explicatus>
        <Aendring id="ide34fad06-931c-4b69-8485-41bdd44dcb3b">
          <AendringDefinition id="idf1fc1bed-8dce-48b2-99cf-d55bd7533b02">
            <Exitus>
              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 6, stk. 2, </Char>
                <Char>affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id35270ea5-3609-4856-8846-02e63bae817b">
            <AendringNyTekst>
              <Stk id="id5042c096-4013-48c3-8c71-673ccb258afe">
                <Explicatus>Stk. 2.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>For indkomståret 2024 og efterfølgende indkomstår udgør procenten 12,01.</Char>
                  </Linea>
                  <Linea>
                    <Char>For personer, der ikke har pligt til at betale indkomstskat efter § 8 c eller kommunal indkomstskat efter lov om kommunal indkomstskat og statens afregning af grundskyld og dækningsafgift til kommunerne, udgør procenten for indkomståret 2024 og efterfølgende indkomstår 4,01.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
    </AendringCentreretParagraf>
    <IkraftCentreretParagraf id="id292df3f7-66c5-4ed5-863d-7e32712c9f73" localId="2">
      <Explicatus>§ 2</Explicatus>
      <Stk id="id076cea9e-2392-4e6b-bed7-13f2aca26476">
        <Explicatus>Stk. 1.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven træder i kraft dagen efter bekendtgørelsen i Lovtidende.</Char>
          </Linea>
        </Exitus>
      </Stk>
      <Stk id="id92965a11-eeb9-4835-bb4f-91af8fedf25d">
        <Explicatus>Stk. 2.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven har virkning fra og med indkomståret 2024.</Char>
          </Linea>
        </Exitus>
      </Stk>
    </IkraftCentreretParagraf>
  </DokumentIndhold>
