          <AendringDefinition id="idf7a26248-0083-49cd-99e8-690434c8509a">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char formaChar="Italic">§ 44</Char>
                <Char> indsættes som </Char>
                <Char signiChar="AendringURN" formaChar="Italic">2. pkt.:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id2534e8f7-a1aa-4faf-ac9c-4d78fee95bcb">
            <AendringNyTekst>
              <Exitus>
                <Linea>
                  <Char>1. pkt. gælder dog ikke ved overførsel af midler som nævnt i § 42 A, stk. 3.</Char>
                </Linea>
              </Exitus>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
