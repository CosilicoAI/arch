  <DokumentIndhold id="idaf723341-a0d4-4954-9b01-4422603d85f4">
    <Hymne id="id7e20801d-8390-4e41-a33d-882aad2c2915">
      <Exitus>
        <Linea>
          <Char>VI MARGRETHE DEN ANDEN, af Guds Nåde Danmarks Dronning, gør vitterligt:</Char>
        </Linea>
      </Exitus>
      <Exitus>
        <Linea>
          <Char>Folketinget har vedtaget og Vi ved Vort samtykke stadfæstet følgende lov:</Char>
        </Linea>
      </Exitus>
    </Hymne>
    <AendringCentreretParagraf id="iddcd65852-343e-4148-a91d-55087c38532b" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I personskatteloven, jf. lovbekendtgørelse nr. 1284 af 14. juni 2021, som ændret ved lov nr. 252 af 25. februar 2022, foretages følgende ændring:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="id36cb1424-6f91-40f0-bcb1-90e85ca86890">
        <Explicatus>1.</Explicatus>
        <Aendring id="iddcaaa621-0642-4268-b48b-769ee5c13c1c">
          <AendringDefinition id="idbfda62ce-5c9e-43cb-a6a4-22ed53b44271">
            <Exitus>
              <Linea>
                <Char signiChar="AendringURN" formaChar="Italic">§ 6, stk. 2, </Char>
                <Char>affattes således:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="idd8e5f588-6d3d-4832-a5a5-f2a24ffd84cc">
            <AendringNyTekst>
              <Stk id="id01c30630-827b-4d2c-9e8e-c21d5460f18a">
                <Explicatus>Stk. 2.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>For indkomståret 2023 og efterfølgende indkomstår udgør procenten 12,06.</Char>
                  </Linea>
                  <Linea>
                    <Char>For personer, der ikke har pligt til at betale indkomstskat efter § 8 c eller kommunal indkomstskat efter lov om kommunal indkomstskat, udgør procenten for indkomståret 2023 og efterfølgende indkomstår 4,06.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
    </AendringCentreretParagraf>
    <IkraftCentreretParagraf id="id17c161e9-07b3-45cd-b383-5cc38d935822" localId="2">
      <Explicatus>§ 2</Explicatus>
      <Stk id="id608029ed-481e-43d3-95dc-9ba1e5206c23">
        <Explicatus>Stk. 1.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven træder i kraft den 1. juni 2023.</Char>
          </Linea>
        </Exitus>
      </Stk>
      <Stk id="id9c4a6340-77f7-42a9-b477-c64eafd21569">
        <Explicatus>Stk. 2.</Explicatus>
        <Exitus>
          <Linea>
            <Char>Loven har virkning fra og med indkomståret 2023.</Char>
          </Linea>
        </Exitus>
      </Stk>
    </IkraftCentreretParagraf>
