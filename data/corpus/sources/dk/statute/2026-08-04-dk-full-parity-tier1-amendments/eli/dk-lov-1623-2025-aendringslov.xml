        <Aendring id="id7a891bd7-10dd-4084-9bb8-095095a5f682">
          <AendringDefinition id="id44fc5029-6446-4002-8c07-950b3d3bde45">
            <Exitus>
              <Linea>
                <Char formaChar="Italic">§ 4, stk. 1, nr. 2, </Char>
                <Char>ophæves.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id854c3d83-0516-4478-888b-89c36ad7e952">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
        <Rykningsklausul id="id6e3d5dcb-fb4a-45e5-a05c-51a742afb9ab">
          <Exitus>
            <Linea>
              <Char>Nr. 3 bliver herefter nr. 2.</Char>
            </Linea>
          </Exitus>
        </Rykningsklausul>
      </AendringsNummer>
      <AendringsNummer id="idc198c496-4f20-47f2-bf32-0d5992636087">
