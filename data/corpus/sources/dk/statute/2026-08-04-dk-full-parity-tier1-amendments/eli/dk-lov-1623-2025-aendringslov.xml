      <AendringsNummer id="id09e25f31-a908-49f2-8cbd-b6f10cf60327">
        <Explicatus>6.</Explicatus>
        <Aendring id="idb0730bf4-5983-444e-afc5-398ba29d9b9a">
          <AendringDefinition id="idbcc3d4b1-29b4-4bbe-b1ab-20ac0a23b363">
            <Exitus>
              <Linea>
                <Char formaChar="Italic">§ 4 c, stk. 1, nr. 8, </Char>
                <Char>ophæves.</Char>
              </Linea>
