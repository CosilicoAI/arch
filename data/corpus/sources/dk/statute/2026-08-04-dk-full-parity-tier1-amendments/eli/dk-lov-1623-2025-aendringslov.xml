    <AendringCentreretParagraf id="id63517b5c-780f-4264-944e-0ec7014c7b07" localId="1">
      <Explicatus>§ 1</Explicatus>
      <Exitus>
        <Linea>
          <Char>I lov om Arbejdsmarkedets Tillægspension, jf. lovbekendtgørelse nr. 1142 af 1. november 2024, som ændret ved § 4 i lov nr. 1655 af 30. december 2024 og § 3 i lov nr. 711 af 20. juni 2025, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="id47588006-a7c4-4250-8cb9-e40ec7f6aa53">
        <Explicatus>1.</Explicatus>
        <Aendring id="id60057113-21bb-42b2-b744-36cac3d21bcd">
          <AendringDefinition id="id09137b71-7adb-423d-9155-9655bd025f5d">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char formaChar="Italic">§ 1</Char>
                <Char> indsættes som </Char>
                <Char formaChar="Italic">stk. 4:</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="id2adcc6fc-7f5b-449e-ba99-f7139770dc20">
            <AendringNyTekst>
              <Stk id="idc46f98fe-b83b-4e87-b1b6-1ec8873b76bc">
                <Explicatus>Stk. 4.</Explicatus>
                <Exitus>
                  <Linea>
                    <Char>Staten kan stille en garanti for afholdelse af udgifter, som Arbejdsmarkedets Tillægspension har til lovforberedende arbejde i forhold til opgaver, jf.  stk. 2, såfremt et lovforslag ikke vedtages af Folketinget.</Char>
                  </Linea>
                </Exitus>
              </Stk>
            </AendringNyTekst>
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
