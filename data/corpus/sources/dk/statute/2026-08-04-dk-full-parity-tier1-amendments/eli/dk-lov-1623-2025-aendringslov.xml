    <AendringCentreretParagraf id="id4c1447cd-3b8b-4b84-b554-afacf713211d" localId="3">
      <Explicatus>§ 3</Explicatus>
      <Exitus>
        <Linea>
          <Char>I lov om Lønmodtagernes Dyrtidsfond, jf. lovbekendtgørelse nr. 17 af 14. januar 2025, som ændret ved § 4 i lov nr. 711 af 20. juni 2025, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="idcd8a93ca-1588-44b9-abd6-bae488ee02e3">
        <Explicatus>1.</Explicatus>
        <Aendring id="id0e0cf168-7fdd-4b86-97e1-d890c7cc40dc">
          <AendringDefinition id="id79684b38-f5ef-411a-b2af-9384d6753b3d">
            <Exitus>
              <Linea>
                <Char>I </Char>
                <Char formaChar="Italic">§ 4, stk. 1, nr. 1, </Char>
                <Char>ændres »2« til: »3«, og »Landsorganisationen i Danmark« ændres til: »Fagbevægelsens Hovedorganisation«.</Char>
              </Linea>
            </Exitus>
          </AendringDefinition>
          <AendringAktion id="ide0b64882-e011-4fb4-8bc8-5bc43ae2c7bb">
            <AendringNyTekst />
          </AendringAktion>
        </Aendring>
      </AendringsNummer>
      <AendringsNummer id="idc8f1fd30-3ee7-4315-ad9d-fe92d5fe2f62">
