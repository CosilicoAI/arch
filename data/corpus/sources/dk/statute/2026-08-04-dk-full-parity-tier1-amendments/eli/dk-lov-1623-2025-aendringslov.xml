      <Exitus>
        <Linea>
          <Char>I lov om arbejdsskadesikring, jf. lovbekendtgørelse nr. 1279 af 4. november 2025, foretages følgende ændringer:</Char>
        </Linea>
      </Exitus>
      <AendringsNummer id="id6331c149-30e7-4e14-8bb8-4afbe5b130ec">
