/b", "parent_id": "ed13ef5a-be38-5722-940e-a1819335badf", "source_as_of": "2026-07-12", "source_format": "uslm-xml", "source_id": "/us/usc/t26/s1401/b/2", "source_path": "sources/us/statute/2026-07-24-1401-coordination-repair-title-26/uslm/usc26.xml", "source_url": "https://uscode.house.gov/view.xhtml?req=granuleid:USC-prelim-title26-section1401&num=0&edition=prelim", "version": "2026-07-24-1401-coordination-repair-title-26"}
